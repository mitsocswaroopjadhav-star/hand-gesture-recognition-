# IntentSense Environment Configuration Template
# Copy this file to .env and configure as needed:
# cp .env.example .env

# Preferred online provider: xAI Grok
# Create an API key at https://console.x.ai/
# Installed macOS app reads this file from:
# ~/Library/Application Support/IntentSense/.env
# Development runs can also export XAI_API_KEY in the shell.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Legacy compatibility: Google Gemini (used only when XAI_API_KEY is not configured)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Custom path to local whisper.cpp executable
# Default: bin/whisper-cli
# WHISPER_CPP_PATH=

# Optional: Custom path to whisper.cpp GGML model file
# Default: models/ggml-base.en.bin
# WHISPER_MODEL_PATH=
