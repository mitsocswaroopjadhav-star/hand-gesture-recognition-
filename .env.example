# IntentSense Environment Configuration Template
# Copy this file to .env and configure as needed:
# cp .env.example .env

# Optional: Google Gemini API Key for Online Conversational AI Coaching
# When unset or offline, IntentSense gracefully uses deterministic local rule-based assistance.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Custom path to local whisper.cpp executable
# Default: bin/whisper-cli
# WHISPER_CPP_PATH=

# Optional: Custom path to whisper.cpp GGML model file
# Default: models/ggml-base.en.bin
# WHISPER_MODEL_PATH=
